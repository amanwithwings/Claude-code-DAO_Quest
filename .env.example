# ── Access key (optional) ────────────────────────────────────────────────────
# Set this to require a passphrase before the app is visible.
# Leave unset (or remove the line) for a fully public deployment.
VITE_ACCESS_KEY=your_secret_word

# ── Tally API (live onchain vote data) ───────────────────────────────────────
# Free API key at https://tally.xyz/add-a-dao (Settings → API)
# NO "VITE_" prefix — this key is used server-side only (Vite proxy in dev,
# Netlify function in prod). It is never bundled into the client JavaScript.
TALLY_API_KEY=your_tally_api_key

# ── WalletConnect ───────────────────────────────────────────────────────────
# Create a free project at https://cloud.walletconnect.com to get a Project ID
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ── Supabase (client — read-only in production) ───────────────────────────────
# Create a free project at https://supabase.com and run supabase/schema.sql
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Supabase service-role key (server-side only — never expose to the client) ──
# Found in Supabase Dashboard → Project Settings → API → service_role key.
# Used by Netlify functions to write verified quest progress and display names.
# Set this in Netlify Dashboard → Site → Environment variables (NOT in .env).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
